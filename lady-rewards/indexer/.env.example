# LadyChain RPC endpoint
LADYCHAIN_RPC=https://ladyrpc.us

# Chain ID
CHAIN_ID=589

# LRP/LADY pair contract address (from LadySwap)
# ⚠️  VERIFY THIS — pair address should be different from the LRP token address
# Find it on LadyCharts or LadySwap by looking at the LRP/LADY pool
PAIR_ADDRESS=0xe1afb1fdd81196a6ffb4217d99981484d4903fac

# LRP token contract
LRP_ADDRESS=0x0F7418A346D88E12eC93337998EE0e9d2365fd12

# Private key for the backend signer wallet (0x482Ab9113724c847EE395539979547773dFf0e02)
# Never share this or commit it to git
SIGNER_PRIVATE_KEY=0x...

# Weekly reward amount in whole LRP tokens (e.g. 50000 = 50,000 LRP)
WEEKLY_REWARD=250000

# Port for the indexer API server
PORT=3001

# Allowed frontend origin for CORS (set to your production URL in prod)
FRONTEND_ORIGIN=http://localhost:5173
